# Bu dosyayı .env adıyla kopyalayın. .env GitHub'a yüklenmez.
# Buraya GERÇEK SQL parolanızı koyup depoya göndermeyin.
NETSIS_SERVER=SUNUCU_ADI
NETSIS_DATABASE=NETSIS_SIRKET_VERITABANI
NETSIS_DRIVER=ODBC Driver 17 for SQL Server

# Önerilen: Windows (entegre) kimlik doğrulama
NETSIS_AUTH=windows

# Yalnızca SQL kullanıcı hesabı gerekiyorsa:
# NETSIS_AUTH=sql
# NETSIS_USER=sinirli_yetkili_kullanici
# NETSIS_PASSWORD=buraya_yerel_ortamda_girin

# Varsayılan: güvenli salt-okunur mod
NETSIS_WRITE_ENABLED=0
